# Optional; MCP automatically starts and authenticates the local headless worker.
PORT=11435
# DATA_DIR=/absolute/path/to/private-data
# BROWSER_HEADLESS=false # optional; defaults to headless task execution after manual login

# Limit local image input to absolute directories you explicitly trust.
# IMAGE_INPUT_ROOTS=/absolute/path/to/screenshots,/absolute/path/to/project/images
# Permit downloads only from these exact trusted HTTPS image hostnames.
# ALLOWED_IMAGE_HOSTS=images.example.com
# Terminal task/artifact retention: 30 days by default, 0 disables expiry.
# TASK_RETENTION_DAYS=30
